# Copia questo file in .env.local e compila i valori. Istruzioni complete in docs/SETUP.md.

# NextAuth (pannello admin)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ADMIN_EMAIL=
# Genera con: npx tsx scripts/hash-password.ts "la-tua-password"
# Attenzione: in locale (.env.local) i simboli $ dell'hash bcrypt vanno
# protetti con la barra rovesciata (\$), altrimenti Next.js li interpreta
# come variabili e tronca l'hash. Lo script sopra stampa già la versione
# corretta da incollare qui. Su Vercel invece va incollato il valore raw
# (senza backslash), perché lì non c'è questa espansione.
ADMIN_PASSWORD_HASH=

# Supabase (database + storage immagini)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (pagamenti)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Smoobu (sincronizzazione disponibilità in background — nessun iframe)
# Autenticazione HMAC: dalla dashboard Smoobu crea una API Key, ottieni sia
# la Key (es. usr_live_...) sia il Secret — servono entrambi.
SMOOBU_API_KEY=
SMOOBU_API_SECRET=
SMOOBU_PROPERTY_ID=
SMOOBU_MOCK=false

# Resend (email di conferma prenotazione all'ospite — facoltativo, best-effort:
# se assente il pagamento resta comunque confermato, solo senza email)
RESEND_API_KEY=

# Opzionale: mappa personalizzata
NEXT_PUBLIC_MAPBOX_TOKEN=
